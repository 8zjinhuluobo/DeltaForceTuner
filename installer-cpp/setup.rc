#include "resource.h"

IDI_APP ICON "assets/app.ico"
1 24 "installer-cpp/setup.manifest"

IDR_APP RCDATA "build-cpp/app.exe"
IDR_UNINSTALL RCDATA "build-cpp/Uninstall.exe"
IDR_README RCDATA "build-cpp/readme.txt"
IDR_README_MD RCDATA "build-cpp/README.md"
IDR_PREVIEW RCDATA "build-cpp/preview.png"
IDR_SHA RCDATA "build-cpp/SHA256.txt"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Local"
            VALUE "FileDescription", "Delta Force Tuner Setup"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "DeltaForceTunerSetup"
            VALUE "OriginalFilename", "DeltaForceTunerSetup.exe"
            VALUE "ProductName", "Delta Force Tuner"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
